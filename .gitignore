# Allow-list: ignore everything in this folder, then let through only what the app needs.
# This keeps the village folders (PDFs, Excel files, plain voters.json) and the data key
# (app-build/DATA_KEY.txt) out of git even when new villages are added.
/*

!/.gitignore
!/CLAUDE.md
!/.vade-report

# the website + API Vercel runs (voter data only in encrypted form, no keys or passwords)
!/voter-search-app/

# build scripts, local test server and instructions, but nothing else from app-build
!/app-build/
/app-build/*
!/app-build/encrypt.mjs
!/app-build/xlsx_to_json.py
!/app-build/import_json.mjs
!/app-build/analyse/
!/app-build/dev-server.mjs
!/app-build/README.md

.DS_Store
node_modules/
.vercel
.env*
