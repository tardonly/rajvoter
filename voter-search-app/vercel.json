{
  "cleanUrls": false,
  "functions": {
    "api/search.js": {
      "includeFiles": "api/_data/**"
    },
    "api/mark.js": {
      "includeFiles": "api/_data/**"
    },
    "api/admin.js": {
      "includeFiles": "api/_data/**"
    },
    "api/progress.js": {
      "includeFiles": "api/_data/**"
    }
  },
  "redirects": [
    {
      "source": "/((?!api/)[a-z0-9-]+)/admin",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/demo-:village([a-z0-9-]+)",
      "destination": "/demo/:village",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/demo/:village([a-z0-9-]+)",
      "destination": "/index.html"
    },
    {
      "source": "/:village([a-z0-9-]+)/manifest.webmanifest",
      "destination": "/api/manifest?village=:village"
    },
    {
      "source": "/:village([a-z0-9-]+)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(|index.html|admin.html|admin)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/demo/:village([a-z0-9-]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:village([a-z0-9-]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
