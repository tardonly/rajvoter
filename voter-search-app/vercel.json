{
  "cleanUrls": false,
  "regions": ["bom1"],
  "functions": {
    "api/data.js": {
      "includeFiles": "api/_data/**"
    }
  },
  "redirects": [
    {
      "source": "/:name(promo-[a-z-]+|short-[a-z-]+).mp4",
      "destination": "https://cdn.jsdelivr.net/gh/ramcala/rajelection-videos@main/:name.mp4",
      "permanent": false
    },
    {
      "source": "/((?!api/)[a-z0-9-]+)/admin",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/demo-:village([a-z0-9-]+)",
      "destination": "/demo/:village",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:fn(search|mark|admin|progress|poster)",
      "destination": "/api/data?fn=:fn"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/promo",
      "destination": "/promo.html"
    },
    {
      "source": "/rajasthan-voter-list",
      "destination": "/rajasthan-voter-list.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/:req(\\d{8})",
      "destination": "/admin.html"
    },
    {
      "source": "/demo/:village([a-z0-9-]+)",
      "destination": "/index.html"
    },
    {
      "source": "/:village([a-z0-9-]+)/manifest.webmanifest",
      "destination": "/api/manifest?village=:village"
    },
    {
      "source": "/:village([a-z0-9-]+)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(|index.html|admin.html|admin)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/demo/:village([a-z0-9-]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:village([a-z0-9-]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:icon([a-z0-9-]+).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/((?!places$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:page(admin|admin\\.html|index\\.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:village((?!promo$|rajasthan-voter-list$|demo$)[a-z0-9-]+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:village([a-z0-9-]+)/:rest(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
